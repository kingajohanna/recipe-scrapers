  </div><article id="post-7820908" class="td-post-template-10 post-7820908 post type-post status-publish format-video has-post-thumbnail hentry category-recept category-video tag-agrar-mez tag-egeszseges tag-egyszeru tag-foetel tag-gyors tag-halas tag-mez tag-recept tag-rizs tag-szezamolaj tag-szojaszosz tag-tokehal post_format-post-format-video main_ingredient-hal seasonal-osz day-period-ebed day-period-vacsora food-type-foetel td-container-wrap" itemscope itemtype="https://schema.org/Article">
