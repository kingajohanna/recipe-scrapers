":false,"sentByUserId":null,"facebookTitle":null,"seoImage":null,"magazineCover":null,"podcastGuestName":null,"podcastGuestNameTitle":null,"seoResearchSource":null,"seoCategorySelector":null,"isOpinionType":null,"isShortNewsType":null,"isFastNewsType":null,"isNotebook":null,"isPodcastType":null,"isGalleryType":null,"isGuaranteeType":null,"mediaShows":[],"isShort":null,"videaUrl":null,"authorSlug":"kompp-koczian-zita","rank":"szerkesztő-újságíró","introduction":null,"thumbnailFocusedImages":[],"sentByUser":null,"tags":[{"id":"1ef21abf-f41e-69da-bed2-599334f4c0a5","slug":"pesto-2","title":"pesto"},{"id":"418658ac-db12-4968-9660-ee0e5260ec03","slug":"voros-pesto","title":"vörös pesto"},{"id":"87d6f0a2-b114-449b-a27f-da20cf23e2b4","slug":"szosz","title":"szósz"},{"id":"aa02ca58-5b0d-4b8c-a4ec-4732fb9ff71e","slug":"tesztaszosz","title":"tésztaszósz"}]},{"id":"1f1bd635-935f-63d2-981f-6573598c2175","contentType":"recipe","preTitle":"","isVideo":"1","hasVideo":"1","hasGallery":"","isVidcast":null,"preTitleColor":"","title":"Smashed burgonya","lead":"Ha szeretitek a ropogós sült burgonyát, ezt a változatot mindenképpen próbáljátok ki! A kilapított burgonya alatt és tetején is ropogósra sül a parmezán, mellé pedig egy friss, zöldfűszeres joghurtmártogatós készül. Készítsétek el köretként, vendégvárónak vagy csak egy jó mártogatóshoz! Érdemes rögtön nagyobb adagot sütni belőle, mert ezek a ropogós burgonyák nagyon gyorsan elfogynak.","chLead":"Ha szeretitek a ropogós sült burgonyát, ezt a változatot mindenképpen próbáljátok ki! A kilapított burgonya alatt és tetején is ropogósra sül a parmezán, mellé pedig egy friss, zöldfűszeres joghurtmártogatós készül. Készítsétek el köretként, vendégvárónak vagy csak egy jó mártogatóshoz! Érdemes rögtön nagyobb adagot sütni belőle, mert ezek a ropogós burgonyák nagyon gyorsan elfogynak.","chExcerpt":"","length":0,"publishDate":"2026-10-01 12:30:00","slug":"smashed-burgonya","columnSlug":"","columnTitle":"","columnOrder":"","columnEmphasizeOnArticleCard":null,"recommendedTitle":"","thumbnail":"https://cdn.mindmegette.hu/2026/10/IUeider7j1DqyjCrk_e227nwAJW9lCKf_UIBOU219UU/fill/1347/758/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzEyYzlmODZhNzNmMDQ3NzRhZDQ5OGZhOTJmNmY0NWVj.webp","secondaryThumbnail":"https://cdn.mindmegette.hu/2026/10/fOUEF6bNtdDedjlTTjszG2W2TDuig9v_tA0RJP7tfwI/fill/1347/758/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzE2YzBiMzhhNmJkMTQ5NTI4NjAxMjg4MTcwODBmMjM2.webp","author":"Kósa Kolos","avatarImage":"https://cdn.mindmegette.hu/2026/10/D6Y30tlA6nf0lBIKeqinDgVV5kr27PMPf6gCGyRtA5A/fill/300/300/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzQwNGUzOGQyY2Y1YTRkYTRhY2E0NDdmOWJmMmEzYTAy.webp","columnTitleColor":"","columnMainColor":"","brand":"","articleSource":"","firstTagId":"1f1949c0-d9cd-6e94-b5ff-77db9934dd5e","firstRegionId":null,"isPaywalled":"0","isRestricted":"0","isAdultsOnly":false,"hasDossiers":false,"articleMedium":"","priorityId":null,"hideThumbnailFromBody":"0","minuteToMinute":null,"difficulty":"Egyszerű","cost":{"key":"cheap","title":"Olcsó"},"madeForPeople":4,"totalTime":45,"isMmeWarranty":"1","isMaestroAuthor":true,"sentByUserId":null,"facebookTitle":null,"seoImage":null,"magazineCover":null,"podcastGuestName":null,"podcastGuestNameTitle":null,"seoResearchSource":null,"seoCategorySelector":null,"isOpinionType":null,"isShortNewsType":null,"isFastNewsType":null,"isNotebook":null,"isPodcastType":null,"isGalleryType":null,"isGuaranteeType":null,"mediaShows":[],"isShort":null,"videaUrl":null,"authorSlug":"kosa-kolos","rank":"gasztronómiai szakember","introduction":"Kósa Kolos vagyok, a Mindmegette gasztronómiai szakembere. Gyerekkorom óta szenvedélyem a főzés. Számos helyen megfordultam a világban, autentikus ízeket és kreatív, előremutató konyhák ízeit kutatva. Több mint húsz évet töltöttem vendéglátásban és rendezvényszervezésben, végigjárva a ranglétrát. A magyarországi sörforradalom egyik kirobbantójaként ismernek, a sör s