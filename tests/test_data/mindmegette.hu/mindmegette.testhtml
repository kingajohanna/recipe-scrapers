.mindmegette.hu/2026/10/0ctOwdfvKnjX9wa2RBFzfZaeTBQZLY5zkie_xqTc7wc/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzhmYmM1ZTkxYmYyZjRhY2M5OGMyN2MyZGU4MTYxY2Qz.webp","4:3":"https://cdn.mindmegette.hu/2026/10/FpUrOc3oNonEKZuOUApJq9LcD1ozL4jyTNgprL0zCHM/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzQxYjJkYWQxNjE2ZDQ0MGE5N2ZhNjMxZGJlNTU3NmVk.webp","3:2":"https://cdn.mindmegette.hu/2026/10/AYQBiN_aAenjZp5ZUFjxe5GVlf8qXE_LARx2n2E_YfM/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzU0NWY4OTM1NmU5ZDQxY2I4ZDRiODVlZjE4ZWNjN2Yy.webp","2:1":"https://cdn.mindmegette.hu/2026/10/aht-38NhSViFDyvO6oHPHGjOU04o6c6daeBXUSwUbKw/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzMzOGU1N2QyMmZjYzQwYzE4OWI1YjllZTVlYzA5ZDk4.webp"}}],"info":[],"meta":{"responseType":"list","dataCount":8,"requestUrl":null,"filterable":[],"orderable":[],"limitable":{"pageCurrent":null,"pageMax":null,"rowAllCount":null,"rowFrom":0,"rowOnPageCount":20}}},"h":{},"s":200,"st":"OK","u":"https://api.mindmegette.hu/publicapi/hu/gastro/experience-occasion/highlighted-in-tape-list","rt":"json"},"2841080664":{"b":{"data":{"id":"21137a3a-02d7-49e9-8c94-29afb80e0f94","title":"Almás pite - a hagyományos recept","breadcrumbTitle":null,"slug":"almas-pite-a-hagyomanyos-recept","recommendedTitle":null,"coverImage":{"fullSizeUrl":"https://cdn.mindmegette.hu/2024/04/DO0QrKKXWA8eISl824A9u-SXlQpQNhTWzaDyuk0LVhg/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzU2MTBmMWZjMzc0YzRhN2Q4Y2JjZDA2MjVkODhhMGQ0.webp","thumbnailUrl":"https://cdn.mindmegette.hu/2024/04/DO0QrKKXWA8eISl824A9u-SXlQpQNhTWzaDyuk0LVhg/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzU2MTBmMWZjMzc0YzRhN2Q4Y2JjZDA2MjVkODhhMGQ0.webp"},"description":null,"makingText":[{"type":"Basic.Wysiwyg.Wysiwyg","id":"ae111720-b609-4933-a65b-2280cab8838b","details":[{"type":"Basic.Wysiwyg.WysiwygDetail","key":"text","value":"\u003Col>\u003Cli>Az almás pite - a hagyományos recept alapján - úgy készül, hogy a sütőport, a sót és a lisztet összekeverjük, majd a hideg vajjal összemorzsoljuk. Hozzáadjuk a tojásokat, a cukrot, a tejfölt és alaposan összegyúrjuk. Legalább fél órára hűtőbe tesszük.\u003C/li>\u003Cli>Az almákat megpucoljuk, nagy lyukú reszelőn lereszeljük, és kifacsarjuk. Ízesítjük cukorral, fahéjjal és citromlével.\u003C/li>\u003Cli>Hűtés után a tésztát 2 részre osztjuk, és lisztezett felületen kinyújtjuk kb. 0,5 cm vastagságúra.\u003C/li>\u003Cli>Egy 38x26 cm-es tepsi alját kibéleljük sütőpapírral, erre kerül az első adag kinyújtott tészta, megszurkáljuk egy villával és megszórjuk vékonyan zsemlemorzsával. Erre terítjük szét az almás tölteléket, majd lefedjük a kinyújtott tészta másik felével. A tetejét is megszurkáljuk.\u003C/li>\u003Cli>180 fokra előmelegített sütőben, légkeverésen kb. 30-40 percig sütjük. Ha kihűlt az almás pite, porcukorral megszórjuk és kockára vágva tálaljuk.\u003Cbr>&nbsp;\u003C/li>\u003C/ol>\u003Ch2>Nézd meg videón, hogyan készül a hagyományos almás pite\u003C/h2>"}],"subComponents":[]},{"type":"Media.Video.Video","id":"f118f734-2404-487e-aeef-3ee9ef37e7c7","details":[{"type":"Media.Video.VideoDetail","key":"video","value":{"id":"3d196f4c-35c7-4efe-b798-145486c036e0","slug":"hagyomanyos-almas-pite-pont-ugy-ahogy-a-nagymamad-csinalta","videaUrl":"https://www.youtube.com/watch?v=ytQ4UfQ-yOw","title":"Hagyományos almás pite - pont úgy, ahogy a nagymamád csinálta!","lead":"Hagyományos almás pite - pont úgy, ahogy a nagymamád csinálta!","description":null,"isActive":true,"isPublic":true,"isDeleted":false,"createdAt":"2023-10-02 12:17:22","uploadedAt":"2023-10-02 12:17:22","thumbnailUrl":null}}],"subComponents":[]},{"type":"Basic.Wysiwyg.Wysiwyg","id":"5e4b1950-aded-4e52-8499-36d0e64c5149","details":[{"type":"Basic.Wysiwyg.WysiwygDetail","key":"text","value":"\u003Cp>&nbsp;\u003C/p>"}],"subComponents":[]}],"categories":[{"title":"alapanyagtípus","slug":"alapanyagtipus","hierar