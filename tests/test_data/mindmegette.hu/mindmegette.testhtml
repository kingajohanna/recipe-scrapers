adeForPeople":8,"totalTime":180,"isMmeWarranty":"1","isMaestroAuthor":false,"sentByUserId":null,"facebookTitle":null,"seoImage":null,"magazineCover":null,"podcastGuestName":null,"podcastGuestNameTitle":null,"seoResearchSource":null,"seoCategorySelector":null,"isOpinionType":null,"isShortNewsType":null,"isFastNewsType":null,"isNotebook":null,"isPodcastType":null,"isGalleryType":null,"isGuaranteeType":null,"mediaShows":[],"isShort":null,"videaUrl":null,"authorSlug":"teglas-kata","rank":"Cukrász","introduction":"Emlékszem, gyerekkoromban egyszer néztem, ahogy édesapám dolgozott a konyhában. Ott, a konyhapulton ülve jelentettem ki, hogy cukrász leszek. 2022 óta vezetem a Mandula sütemény és tortaműhelyt, amit 23 évesen alapítottam. Szeretettel és odaadással készítek minden egyes desszertet, és kívánom, hogy okozzon rengeteg örömöt és mosolyt azok elfogyasztása.","thumbnailFocusedImages":[],"secondaryThumbnailFocusedImages":[],"avatarImageFocusedImages":[],"sentByUser":null,"tags":[{"id":"249412a8-1a6a-4eab-8fbe-e1e22c217265","slug":"hazias","title":"házias"},{"id":"7cdb68c5-74e8-4456-b89b-22a30367e3ea","slug":"citrom","title":"citrom"},{"id":"8f1deff9-e67f-4f11-baae-1b0e04ffa350","slug":"citromtorta","title":"citromtorta"},{"id":"f5fe260e-0d21-4798-9aa0-7439c4169ad6","slug":"desszert","title":"desszert"}]},{"id":"1f19fabb-0c33-655e-bcec-dfffa5212a28","contentType":"recipe","preTitle":"","isVideo":"1","hasVideo":"1","hasGallery":"","isVidcast":null,"preTitleColor":"","title":"Loaded fries, a megpakolt hasábburgonya","lead":"Olyan hasábburgonyát válasszunk, ami készíthető sütőben sütve is.","chLead":"Olyan hasábburgonyát válasszunk, ami készíthető sütőben sütve is.","chExcerpt":"","length":0,"publishDate":"2026-08-24 12:30:20","slug":"loaded-fries","columnSlug":"","columnTitle":"","columnOrder":"","columnEmphasizeOnArticleCard":null,"recommendedTitle":"","thumbnail":"https://cdn.mindmegette.hu/2026/08/tvSiBtz6YAI1azzm9FJslI-b7FgmlDHTpombFMMjHK8/fill/1347/758/no/1/aHR0cHM6