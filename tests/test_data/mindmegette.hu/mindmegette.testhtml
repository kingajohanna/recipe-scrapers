ers":false,"articleMedium":"","priorityId":null,"hideThumbnailFromBody":"0","minuteToMinute":null,"difficulty":"Egyszerű","cost":{"key":"affordable","title":"Megfizethető"},"madeForPeople":4,"totalTime":260,"isMmeWarranty":"1","isMaestroAuthor":true,"sentByUserId":null,"facebookTitle":null,"seoImage":null,"magazineCover":null,"podcastGuestName":null,"podcastGuestNameTitle":null,"seoResearchSource":null,"seoCategorySelector":null,"isOpinionType":null,"isShortNewsType":null,"isFastNewsType":null,"isNotebook":null,"isPodcastType":null,"isGalleryType":null,"isGuaranteeType":null,"mediaShows":[],"isShort":null,"videaUrl":null,"authorSlug":"kosa-kolos","rank":"gasztronómiai szakember","introduction":"Kósa Kolos vagyok, a Mindmegette gasztronómiai szakembere. Gyerekkorom óta szenvedélyem a főzés. Számos helyen megfordultam a világban, autentikus ízeket és kreatív, előremutató konyhák ízeit kutatva. Több mint húsz évet töltöttem vendéglátásban és rendezvényszervezésben, végigjárva a ranglétrát. A magyarországi sörforradalom egyik kirobbantójaként ismernek, a sör szeretete örökre belém ivódott.","thumbnailFocusedImages":[],"secondaryThumbnailFocusedImages":[],"avatarImageFocusedImages":[],"sentByUser":null,"tags":[{"id":"1f19b9aa-4755-64d6-90f5-efe1c635aef2","slug":"posset","title":"posset"},{"id":"249412a8-1a6a-4eab-8fbe-e1e22c217265","slug":"hazias","title":"házias"},{"id":"aa82050d-0a53-48d7-b1a1-98bdbd9b239f","slug":"citromos","title":"citromos"},{"id":"f5fe260e-0d21-4798-9aa0-7439c4169ad6","slug":"desszert","title":"desszert"}]},{"id":"1f19951b-5d81-6650-8aac-13f8124cb54f","contentType":"recipe","preTitle":"","isVideo":"1","hasVideo":"1","hasGallery":"","isVidcast":null,"preTitleColor":"","title":"Meggyes kókuszgolyó","lead":"Ebből a mennyiségből kb. 16-20 db kókuszgolyó készíthető.","chLead":"Ebből a mennyiségből kb. 16-20 db kókuszgolyó készíthető.","chExcerpt":"","length":0,"publishDate":"2026-08-18 12:30:54","slug":"meggyes-kokuszgolyo","columnSlug":"","columnTitle"