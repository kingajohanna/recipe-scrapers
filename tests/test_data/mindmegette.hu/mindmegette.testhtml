,"recommendedTitle":"","thumbnail":"https://cdn.mindmegette.hu/2026/09/F5rWSkpQaif1EDgc7om6xXPZfjFeYi1oxn7QCbc7xZI/fill/1347/758/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50L2QyYTZkYzI1YTA1ZTRjNTFiZGMzOGFlYzFlMzhjZjc5.webp","secondaryThumbnail":null,"author":"Koháriné Szabó Éva","avatarImage":"https://cdn.mindmegette.hu/2026/09/Y9AY7kjl4zr2j1yXQWfZ56LQq0hDp_7i2HuzmFUiQxk/fill/300/300/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50Lzk0OTUyMDEwMmZmMTQ2MTliZTBkNzFkNWI2ZjJjNDY5.webp","columnTitleColor":"","columnMainColor":"","brand":"","articleSource":"","firstTagId":"249412a8-1a6a-4eab-8fbe-e1e22c217265","firstRegionId":null,"isPaywalled":"0","isRestricted":"0","isAdultsOnly":false,"hasDossiers":false,"articleMedium":"","priorityId":null,"hideThumbnailFromBody":"0","minuteToMinute":null,"difficulty":"Egyszerű","cost":{"key":"affordable","title":"Megfizethető"},"madeForPeople":6,"totalTime":45,"isMmeWarranty":"1","isMaestroAuthor":true,"sentByUserId":null,"facebookTitle":null,"seoImage":null,"magazineCover":null,"podcastGuestName":null,"podcastGuestNameTitle":null,"seoResearchSource":null,"seoCategorySelector":null,"isOpinionType":null,"isShortNewsType":null,"isFastNewsType":null,"isNotebook":null,"isPodcastType":null,"isGalleryType":null,"isGuaranteeType":null,"mediaShows":[],"isShort":null,"videaUrl":null,"authorSlug":"koharine-szabo-eva","rank":"Gluténmentes Íz-Lik","introduction":"Sára lányom 2013 óta diagnosztizált cöliákiás, Ő és én vagyunk gluténmentes diétán a családban. Az évek alatt sokat tanultam a gluténmentességről, és tapasztalataimat megosztottam a Gluténmentes Íz-lik nevű oldalamon. A Gluténmentes Íz-lik egy olyan hely, ahol a lisztérzékenység nem probléma, gond, hanem megoldandó feladat. Itt jól érezzük magunkat, mert a sütés-főzés hobbi és kihívás.","thumbnailFocusedImages":[],"avatarImageFocusedImages":[],"sentByUser":null,"tags":[{"id":"249412a8-1a6a-4eab-8fbe-e1e22c217265","slug":"hazias","title":"házias"},{"id":"5cb9